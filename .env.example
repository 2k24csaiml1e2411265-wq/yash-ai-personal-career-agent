# ---------------------------------------------------------------------------
# Yash AI — environment configuration
# Copy this file to .env and fill in real values. Never commit the real .env.
# The application starts and works fully (portfolio + fallback agent
# responses) even if every LLM_* variable below is left blank.
# ---------------------------------------------------------------------------

# --- LLM provider (optional — leave blank for fallback mode) ---
# Any OpenAI-compatible chat-completions API works (Groq, OpenAI, Together, ...)
LLM_PROVIDER=none
LLM_API_KEY=
MODEL_NAME=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1/chat/completions
LLM_TIMEOUT_SECONDS=20

# --- GitHub (optional — used for the live GitHub section) ---
GITHUB_USERNAME=2k24csaiml1e2411265-wq
GITHUB_TOKEN=

# --- CORS: comma-separated list of allowed frontend origins ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Retrieval tuning ---
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=0.12

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# --- Data location (defaults to ../data relative to backend/) ---
DATA_DIR=

# ---------------------------------------------------------------------------
# Frontend (frontend/.env) — separate file, documented here for convenience
# ---------------------------------------------------------------------------
# VITE_API_BASE_URL=http://localhost:8000
